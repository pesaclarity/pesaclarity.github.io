---
import { darkScreen } from "../lib/screens";
import { withBase } from "../lib/paths";
import type { Screen } from "../data/site";

/* One app screen, with its dark version in dark mode when it has one. */
interface Props {
  screen: Screen;
  class?: string;
  /** Load the light screen at once, for one near the top of a page. */
  eager?: boolean;
  /** The page's main image: load it first (implies eager). */
  priority?: boolean;
}

const {
  screen,
  class: className,
  eager = false,
  priority = false,
} = Astro.props;
const dark = darkScreen(screen.file);
---

<img
  class:list={[className, { "screen-light": dark }]}
  src={withBase(`/screens/${screen.file}.webp`)}
  width="390"
  height="844"
  alt={screen.alt}
  loading={eager || priority ? undefined : "lazy"}
  decoding={eager || priority ? undefined : "async"}
  fetchpriority={priority ? "high" : undefined}
/>
{dark && (
  <img
    class:list={[className, "screen-dark"]}
    src={withBase(`/screens/${dark}.webp`)}
    width="390"
    height="844"
    alt={screen.alt}
    loading="lazy"
    decoding="async"
  />
)}
