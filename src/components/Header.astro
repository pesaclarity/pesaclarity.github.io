---
import { withBase } from "../lib/paths";
import Mark from "./Mark.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import PlayButton from "./PlayButton.astro";

const nav = [
  { href: withBase("/features/"), label: "Features" },
  { href: withBase("/analyse/"), label: "Statement analyser" },
  { href: withBase("/help/"), label: "Help" },
  { href: withBase("/docs/"), label: "Docs" },
  { href: withBase("/security/"), label: "Security" },
];
const path = Astro.url.pathname;
const current = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase("/")} aria-label="Pesa Clarity home">
      <Mark size={36} />
      <span class="wordmark" aria-hidden="true">
        pesa <span>clarity</span>
      </span>
    </a>
    <div class="header-end">
      <nav class="nav-wide" aria-label="Main">
        <ul class="nav-list">
          {nav.map((item) => (
            <li>
              <a
                class="nav-link"
                href={item.href}
                aria-current={current(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a
              class="button button-secondary nav-cta"
              href={withBase("/sponsor/")}
              aria-current={current(withBase("/sponsor/")) ? "page" : undefined}
            >
              Sponsor
            </a>
          </li>
        </ul>
      </nav>
      {/* On phones the same links sit behind Menu: a details element, so it
          opens with no script. */}
      <details class="menu">
        <summary class="button button-secondary">Menu</summary>
        <nav class="menu-panel" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={current(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <a href={withBase("/sponsor/")}>Sponsor</a>
            </li>
            <li>
              <a href={withBase("/changes/")}>What's new</a>
            </li>
          </ul>
        </nav>
      </details>
      <PlayButton label="Download" class="nav-cta" />
      <ThemeSwitch />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-background) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--size-touch-target);
    color: var(--color-text);
    text-decoration: none;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .wordmark span {
    color: var(--color-brand-link);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch-target);
    padding-inline: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    border-radius: var(--radius-pill);
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    background: var(--color-subtle);
  }

  .nav-cta {
    padding-inline: var(--space-4);
  }

  .nav-list .nav-cta {
    margin-left: var(--space-3);
  }

  /* Menu, for narrow screens */
  .menu {
    position: relative;
    display: none;
  }

  .menu summary {
    list-style: none;
    cursor: pointer;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu[open] summary {
    border-color: var(--color-text-muted);
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    min-width: 14rem;
    padding: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 20px 40px -24px var(--color-shadow);
  }

  .menu-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-panel a {
    display: flex;
    align-items: center;
    min-height: var(--size-touch-target);
    padding-inline: var(--space-4);
    border-radius: var(--radius-small);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
  }

  .menu-panel a:hover,
  .menu-panel a[aria-current="page"] {
    background: var(--color-subtle);
  }

  @media (max-width: 62rem) {
    .nav-wide {
      display: none;
    }

    .menu {
      display: block;
    }
  }

  /* Room for Menu and Download on a phone: the mark alone. Below 37.5rem the
     two-word wordmark, Menu, Download and the theme switch don't fit in a row. */
  @media (max-width: 37.5rem) {
    .wordmark {
      display: none;
    }
  }
</style>
