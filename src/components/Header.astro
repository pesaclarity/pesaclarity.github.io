---
import { withBase } from "../lib/paths";
import Mark from "./Mark.astro";
import { downloads } from "../data/site";

interface Props {
  onHome: boolean;
}
const { onHome } = Astro.props;
const base = onHome ? "" : withBase("/");
const nav = [
  { href: `${base}#what`, label: "What it does" },
  { href: `${base}#screens`, label: "Screens" },
  { href: withBase("/features/"), label: "Features" },
  { href: `${base}#privacy`, label: "Privacy" },
  { href: `${base}#faq`, label: "FAQ" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase("/")} aria-label="Pesa Clarity home">
      <Mark size={36} />
      <span class="wordmark" aria-hidden="true">
        pesa<span>clarity</span>
      </span>
    </a>
    <div class="header-end">
      <nav aria-label="Main">
        <ul class="nav-list">
          {nav.map((item) => (
            <li class="nav-section">
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
          <li>
            <a
              class="button button-secondary nav-cta nav-sponsor"
              href={withBase("/sponsor/")}
            >
              Sponsor
            </a>
          </li>
          <li>
            <a class="button button-primary nav-cta" href={downloads.android}>
              Download
            </a>
          </li>
        </ul>
      </nav>
      <!-- Shown only when the theme script runs (it sets data-theme-choice). -->
      <button
        type="button"
        class="theme-switch"
        data-theme-switch
        aria-label="Theme: System. Change to Light"
        title="Change to Light"
      >
        <svg
          class="theme-icon theme-icon-system"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <circle
            cx="12"
            cy="12"
            r="8.25"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
          />
          <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor" />
        </svg>
        <svg
          class="theme-icon theme-icon-light"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <circle
            cx="12"
            cy="12"
            r="4.25"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
          />
          <path
            d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.75 1.75M16.95 16.95l1.75 1.75M5.3 18.7l1.75-1.75M16.95 7.05l1.75-1.75"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          />
        </svg>
        <svg
          class="theme-icon theme-icon-dark"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M20 14.5A8.25 8.25 0 0 1 9.5 4a8.25 8.25 0 1 0 10.5 10.5z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linejoin="round"
          />
        </svg>
        <span class="theme-name" data-theme-name aria-hidden="true">
          System
        </span>
      </button>
      <span class="visually-hidden" role="status" data-theme-status></span>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-background) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--size-touch-target);
    color: var(--color-text);
    text-decoration: none;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
  }

  .wordmark span {
    color: var(--color-brand-link);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-section a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch-target);
    padding-inline: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    border-radius: var(--radius-pill);
  }

  .nav-section a:hover {
    background: var(--color-subtle);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Without the theme script the switch could not work, so it stays hidden. */
  .theme-switch {
    display: none;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: var(--size-touch-target);
    min-height: var(--size-touch-target);
    padding: 0 var(--space-3);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  :global([data-theme-choice]) .theme-switch {
    display: inline-flex;
  }

  .theme-switch:hover {
    border-color: var(--color-text-muted);
  }

  .theme-icon {
    display: none;
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }

  :global([data-theme-choice="system"]) .theme-icon-system,
  :global([data-theme-choice="light"]) .theme-icon-light,
  :global([data-theme-choice="dark"]) .theme-icon-dark {
    display: block;
  }

  .nav-cta {
    margin-left: var(--space-2);
    padding-inline: var(--space-4);
  }

  @media (max-width: 64rem) {
    .nav-section {
      display: none;
    }
  }

  /* Room for Sponsor and Download on a phone: the mark alone, and the
     theme switch as its icon (its name is still in its label). */
  @media (max-width: 30rem) {
    .wordmark,
    .theme-name {
      display: none;
    }

    .theme-switch {
      padding: 0;
    }
  }
</style>
