---
import { withBase } from "../lib/paths";
import type { Screen } from "../data/site";

interface Props {
  screens: readonly Screen[];
  /** Names the row for screen readers when it scrolls. */
  label: string;
}

const { screens, label } = Astro.props;
// Up to four sit in a grid; more scroll sideways, as on a phone.
const scrolls = screens.length > 4;
---

<div
  class:list={["gallery-wrap", { scrolls }]}
  role={scrolls ? "region" : undefined}
  aria-label={scrolls ? label : undefined}
  tabindex={scrolls ? 0 : undefined}
>
  <ul class="gallery" role="list">
    {screens.map((s) => (
      <li>
        <img
          src={withBase(`/screens/${s.file}.webp`)}
          width="390"
          height="844"
          alt={s.alt}
          loading="lazy"
          decoding="async"
        />
        <p>{s.name}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  .gallery {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .gallery > li {
    min-width: 0;
    text-align: center;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2rem;
    border: 6px solid var(--color-device);
    box-shadow: 0 30px 60px -30px rgb(58 47 51 / 0.4);
  }

  .gallery p {
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-weight: 600;
  }

  /* More than four screens make a row that scrolls sideways; the row is
     the region keyboard users focus to scroll it. */
  .scrolls {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--color-border) transparent;
    margin-inline: calc(var(--gutter) * -1);
    padding: var(--space-2) var(--gutter) var(--space-5);
    scroll-padding-inline: var(--gutter);
  }

  .scrolls .gallery {
    display: flex;
    gap: var(--space-5);
    width: max-content;
  }

  .scrolls .gallery > li {
    flex: 0 0 clamp(13rem, 21vw, 17rem);
    scroll-snap-align: start;
  }

  .scrolls:focus-visible {
    outline-offset: -3px;
  }

  @media (max-width: 52rem) {
    .gallery {
      display: flex;
      gap: var(--space-4);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) var(--space-3);
      scroll-padding-inline: var(--gutter);
    }

    .gallery > li {
      flex: 0 0 min(70%, 16rem);
      scroll-snap-align: start;
    }

    .scrolls .gallery {
      overflow: visible;
      margin: 0;
      padding: 0;
      gap: var(--space-4);
    }

    .scrolls .gallery > li {
      flex-basis: min(70vw, 16rem);
    }
  }
</style>
