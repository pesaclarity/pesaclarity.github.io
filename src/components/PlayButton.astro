---
// A site button that opens the app's Google Play listing, with the Play mark.
import { links } from "../data/site";

interface Props {
  label?: string;
  class?: string;
}

const { label = "Get it on Google Play", class: className } = Astro.props;
---

<a
  class:list={["button button-primary play-button", className]}
  href={links.play}
>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
    <path
      fill="currentColor"
      d="M4.6 2.2c-.3.3-.4.7-.4 1.2v17.2c0 .5.1.9.4 1.2l9.7-9.8L4.6 2.2Zm10.8 10.9 2.8 2.8-11.9 6.8 9.1-9.6Zm0-2.2L6.3 1.3l11.9 6.8-2.8 2.8Zm3.9-2.1 3.1 1.8c.9.5.9 1.3 0 1.8l-3.1 1.8-3-3 3-2.4Z"
    />
  </svg>
  <span>{label}</span>
</a>

<style>
  @media (max-width: 480px) {
    .play-button.nav-cta svg {
      display: none;
    }
  }

  .play-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
