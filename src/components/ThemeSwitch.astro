---
/* The colour theme switch: System, Light, Dark. The inline theme script
   (src/lib/theme.ts) runs it. */
---

<!-- Shown only when the theme script runs (it sets data-theme-choice). -->
<button
  type="button"
  class="theme-switch"
  data-theme-switch
  aria-label="Theme: System. Change to Light"
  title="Change to Light"
>
  <svg
    class="theme-icon theme-icon-system"
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <circle
      cx="12"
      cy="12"
      r="8.25"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
    />
    <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor" />
  </svg>
  <svg
    class="theme-icon theme-icon-light"
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <circle
      cx="12"
      cy="12"
      r="4.25"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
    />
    <path
      d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.75 1.75M16.95 16.95l1.75 1.75M5.3 18.7l1.75-1.75M16.95 7.05l1.75-1.75"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
    />
  </svg>
  <svg
    class="theme-icon theme-icon-dark"
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M20 14.5A8.25 8.25 0 0 1 9.5 4a8.25 8.25 0 1 0 10.5 10.5z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linejoin="round"
    />
  </svg>
  <span class="theme-name" data-theme-name aria-hidden="true">
    System
  </span>
</button>
<span class="visually-hidden" role="status" data-theme-status></span>

<style>
  /* Without the theme script the switch could not work, so it stays hidden. */
  .theme-switch {
    display: none;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: var(--size-touch-target);
    min-height: var(--size-touch-target);
    padding: 0 var(--space-3);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  :global([data-theme-choice]) .theme-switch {
    display: inline-flex;
  }

  .theme-switch:hover {
    border-color: var(--color-text-muted);
  }

  .theme-icon {
    display: none;
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }

  :global([data-theme-choice="system"]) .theme-icon-system,
  :global([data-theme-choice="light"]) .theme-icon-light,
  :global([data-theme-choice="dark"]) .theme-icon-dark {
    display: block;
  }

  /* On a phone the icon alone; its name is still in its label. */
  @media (max-width: 30rem) {
    .theme-name {
      display: none;
    }

    .theme-switch {
      padding: 0;
    }
  }
</style>
