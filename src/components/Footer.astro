---
import { withBase } from "../lib/paths";
import Mark from "./Mark.astro";
import { links, supportMail } from "../data/site";

const year = new Date().getFullYear();
const groups = [
  {
    title: "App",
    links: [
      { href: withBase("/features/"), label: "Everything it does" },
      { href: withBase("/install/"), label: "Install on Android" },
      { href: withBase("/changes/"), label: "Changes" },
      { href: withBase("/sponsor/"), label: "Sponsor" },
    ],
  },
  {
    title: "Support",
    links: [
      { href: withBase("/help/"), label: "Help" },
      { href: withBase("/help/getting-started/"), label: "Getting started" },
      { href: supportMail("Pesa Clarity help"), label: "Contact us" },
      { href: withBase("/security/"), label: "Security" },
    ],
  },
  {
    title: "Developers",
    links: [
      { href: withBase("/docs/"), label: "Docs" },
      { href: links.github, label: "GitHub" },
      { href: links.webSource, label: "Website source" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: withBase("/privacy/"), label: "Privacy policy" },
      { href: withBase("/terms/"), label: "Terms" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Mark size={28} />
      <p>
        Pesa Clarity is an independent, open-source project. Pre-alpha, Android
        first.
      </p>
    </div>
    <nav class="footer-groups" aria-label="Footer">
      {groups.map((g) => (
        <div class="footer-group">
          <h2>{g.title}</h2>
          <ul>
            {g.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <p class="legal muted">
      © {year} Pesa Clarity contributors. Site code under{" "}
      <a href={`${links.webSource}/blob/main/LICENSE`}>AGPL-3.0</a>; site text
      and images under{" "}
      <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. The
      Pesa Clarity name and logo are trademarks and are not covered by either
      licence. This site sets no cookies and runs no analytics.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding-block: var(--space-7);
    font-size: var(--text-sm);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-6);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-brand p {
    margin: 0;
  }

  .footer-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-5);
  }

  @media (min-width: 48rem) {
    .footer-groups {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-2);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  ul a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch-target);
    color: var(--color-text);
    text-decoration: none;
  }

  ul a:hover {
    text-decoration: underline;
  }

  .legal {
    margin: 0;
    max-width: var(--width-prose);
  }
</style>
