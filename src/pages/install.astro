---
import Base from "../layouts/Base.astro";
import {
  apks,
  appRelease,
  downloads,
  iphoneTools,
  links,
  whatsNew,
} from "../data/site";
import { formatDay, formatSize } from "../data/release.mjs";

const release = appRelease;
const releaseDay = release ? formatDay(release.date) : null;
const sizeOf = (file: string) => formatSize(release?.sizes[file] ?? NaN);
const changes = release?.changes ?? [];
---

<Base
  title="Install on Android"
  description="How to install Pesa Clarity from its APK file and let it read your M-Pesa and bank messages."
>
  <article class="container install-page">
    <div class="prose">
      <p class="eyebrow">Install</p>
      <h1>Install on Android</h1>
      <p class="muted">
        Pesa Clarity is not on Google Play yet, so you install it from a file.
        It takes a few minutes, once.
      </p>

      <h2 id="download">1. Download the app</h2>
      <p>
        On your phone, tap the file for your phone. Most phones take the first
        one.
      </p>
      {release && (
        <p class="muted" data-version={release.version}>
          Version {release.version}
          {releaseDay ? `, ${releaseDay}` : ""}.
          {downloads.testBuild ? " Test build, updated often." : ""}
        </p>
      )}
      <ul class="apks" role="list">
        {apks.map((apk) => (
          <li>
            <a class="apk" href={apk.href}>
              <span class="apk-label">{apk.label}</span>
              <span class="apk-body">{apk.body}</span>
              {sizeOf(apk.file) && (
                <span class="apk-size number">{sizeOf(apk.file)}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
      <p>
        Older or Android Go phone? Take the one for older phones.{" "}
        <a href={links.releases}>All releases</a> are on GitHub.
      </p>

      <h2>2. Allow the install</h2>
      <ol>
        <li>Open the downloaded file, from the notification or from Files.</li>
        <li>
          If Android says it can't install apps from this source, tap{" "}
          <strong>Settings</strong>, switch on{" "}
          <strong>Allow from this source</strong>, then go back.
        </li>
        <li>
          Tap <strong>Install</strong>.
        </li>
        <li>
          If Play Protect shows a warning, tap <strong>More details</strong>,
          then <strong>Install anyway</strong>. The app is new, so Google does
          not know it yet; its code is open for anyone to check on{" "}
          <a href={links.star}>GitHub</a>.
        </li>
      </ol>

      <h2>3. Let it read your messages</h2>
      <p>
        Open Pesa Clarity, pick your accounts and tap{" "}
        <strong>Allow access to messages</strong>. If Android asks, choose{" "}
        <strong>Allow</strong>.
      </p>
      <p>
        On Android 13 and newer, an app installed from a file may not be allowed
        to read SMS until you say so. If nothing happens, or SMS says{" "}
        <strong>Restricted setting</strong>:
      </p>
      <ol>
        <li>
          Open <strong>Settings</strong>, then <strong>Apps</strong>, then{" "}
          <strong>Pesa Clarity</strong>.
        </li>
        <li>
          Tap <strong>⋮</strong> at the top right, then{" "}
          <strong>Allow restricted settings</strong>, and confirm with your PIN
          or fingerprint. On some phones the ⋮ menu is at the bottom of App
          info.
        </li>
        <li>
          Open <strong>Permissions</strong>, then <strong>SMS</strong>, and
          choose <strong>Allow</strong>.
        </li>
        <li>
          Back in the app, tap <strong>I have allowed it</strong>, then scan
          your messages.
        </li>
      </ol>
      <h3 id="xiaomi">Xiaomi, Redmi and POCO phones</h3>
      <p>
        On these phones there is often no{" "}
        <strong>Allow restricted settings</strong> option, and SMS shows{" "}
        <strong>App was denied access</strong>. Install through Obtainium
        instead, a free, open-source app store that takes the app straight from
        our releases. Apps it installs are not restricted, and it keeps Pesa
        Clarity up to date.
      </p>
      <ol>
        <li>Uninstall Pesa Clarity if you already installed it from a file.</li>
        <li>
          Download <a href={links.obtainium}>Obtainium</a> (the file ending{" "}
          <code>arm64-v8a-release.apk</code>) and install it.
        </li>
        <li>
          In Obtainium tap <strong>Add app</strong>, paste{" "}
          <code>{links.appSource}</code>, switch on{" "}
          <strong>Include prereleases</strong> and tap <strong>Add</strong>.
        </li>
        <li>
          Install <code>{apks[0].file}</code> when it offers the files, then
          open Pesa Clarity and allow SMS.
        </li>
      </ol>
      <p>
        Pesa Clarity reads messages only from the accounts you pick, and only on
        your phone.
      </p>

      <h2 id="iphone">On iPhone</h2>
      <p>
        Pesa Clarity is not on the App Store yet, and iPhones only install apps
        signed by Apple or by you. You can sign a test build with your own Apple
        ID, for free. It then works for 7 days at a time.
      </p>
      <ol>
        <li>
          Set up <a href={iphoneTools.sideStore}>SideStore</a> on the iPhone,
          following its guide. You need a computer once, to pair the phone.
          <a href={iphoneTools.altStore}>AltStore</a> works too, with a computer
          on the same Wi-Fi.
        </li>
        <li>
          In SideStore open <strong>Sources</strong>, tap <strong>+</strong>
          and add <code>{downloads.iosSource}</code>. Pesa Clarity shows up; tap{" "}
          <strong>Get</strong> and sign in with your Apple ID. No source?
          Download the <a href={downloads.ios}>iPhone test build</a> in Safari
          and open it from <strong>My Apps</strong> › <strong>+</strong>.
        </li>
        <li>
          Open Pesa Clarity. iPhones never let apps read SMS, so tap{" "}
          <strong>Connect your messages</strong> and set up the Shortcuts
          automation it shows. Older months come from a statement import.
        </li>
      </ol>
      <p>
        Every 7 days the app needs signing again. SideStore does it for you over
        Wi-Fi; with AltStore, keep its computer on the same Wi-Fi with AltServer
        running. Signing again keeps your data. Sign-in is off on these builds.
        Have a Mac? You can{" "}
        <a href={iphoneTools.xcodeSteps}>install it with Xcode</a> instead.
      </p>

      <h2>Updating</h2>
      <p>
        Download the newest file the same way and install it over the app you
        have. Your data stays. Uninstalling first deletes it, and you would need
        to allow messages again.
      </p>
      <p>
        On iPhone, SideStore shows <strong>Update</strong> when a new test build
        is out, if you added the source. Otherwise download the newest file and
        open it the same way. Either keeps your data.
      </p>

      {changes.length > 0 && release && (
        <section id="whats-new" aria-labelledby="whats-new-title">
          <h2 id="whats-new-title">{whatsNew.title(release.version)}</h2>
          <ul class="changes">
            {changes.map((change) => (
              <li>{change}</li>
            ))}
          </ul>
        </section>
      )}

      <h2>Still stuck?</h2>
      <p>
        <a href={links.appIssues}>Tell us what your phone shows</a>, with its
        model and Android version, and we will help.
      </p>
    </div>
  </article>
</Base>

<style>
  .install-page {
    padding-block: var(--space-7) var(--space-8);
  }

  h2 {
    margin-top: var(--space-6);
  }

  ol li,
  .changes li {
    margin-block: var(--space-2);
  }

  .apks {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0;
  }

  @media (min-width: 40rem) {
    .apks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .apk {
    display: grid;
    grid-template-columns: 1fr auto;
    align-content: start;
    gap: var(--space-1) var(--space-4);
    height: 100%;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
  }

  .apk:hover {
    border-color: var(--color-text-muted);
  }

  .apks li:first-child .apk {
    border: 2px solid var(--color-brand);
  }

  .apk-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-brand-link);
  }

  .apk-body {
    grid-column: 1;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .apk-size {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-weight: 600;
  }
</style>
