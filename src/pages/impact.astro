---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/paths";
import { goals, notEndorsed, problems, sources } from "../data/impact";
---

<Base
  title="Impact"
  description="The problem Pesa Clarity solves, and the UN Sustainable Development Goals it aims to contribute to."
>
  <section class="page-hero" aria-labelledby="page-title">
    <div class="container">
      <p class="eyebrow">Impact</p>
      <h1 id="page-title">Clear money, for everyone.</h1>
      <p class="lead">
        Pesa Clarity reads your M-Pesa and bank SMS on your phone, privately and
        for free, and turns them into a plan and simple books.
      </p>
    </div>
  </section>

  <section id="problem" class="section" aria-labelledby="problem-title">
    <div class="container">
      <h2 id="problem-title" class="label">
        The problem
      </h2>
      <ul class="cards problems" role="list">
        {problems.map((p) => (
          <li class="card-item">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
      <div class="answer">
        <p class="statement">
          So Pesa Clarity reads the messages already on your phone and turns
          them into a daily plan, and for a business, simple books.
        </p>
        <p class="muted">
          Nothing leaves your phone to do it.{" "}
          <a href={withBase("/security/#on-your-phone")}>
            What stays on your phone
          </a>
        </p>
      </div>
    </div>
  </section>

  <section id="goals" class="section section-alt" aria-labelledby="goals-title">
    <div class="container">
      <div class="section-head">
        <h2 id="goals-title">The goals it aims to serve</h2>
        <p>
          Three of the UN Sustainable Development Goals, and the one target in
          each that the app's features reach.
        </p>
      </div>
      <ul class="goals" role="list">
        {goals.map((g) => (
          <li class="goal">
            <div class="goal-head">
              <span class={`sdg sdg-${g.n}`} aria-hidden="true">
                {g.n}
              </span>
              <div>
                <p class="goal-name">
                  Goal {g.n}: {g.goal}
                </p>
                <h3>Target {g.target}</h3>
              </div>
            </div>
            <blockquote class="wording" cite={g.source}>
              <p>{g.wording}</p>
            </blockquote>
            <p class="how">{g.how}</p>
            <p class="features muted">
              <span class="features-label">Features:</span> {g.features}
            </p>
            <a class="more" href={g.href}>
              See the features
            </a>
          </li>
        ))}
      </ul>
      <div class="honest">
        <h3>How we say it</h3>
        <p>
          Pesa Clarity aims to contribute to these targets. It doesn't claim to
          achieve them, and it has no measured results yet. {notEndorsed}
        </p>
      </div>
    </div>
  </section>

  <section id="sources" class="section" aria-labelledby="sources-title">
    <div class="container split">
      <h2 id="sources-title" class="label">
        Sources
      </h2>
      <ul class="sources" role="list">
        {sources.map((s) => (
          <li>
            <a href={s.href}>{s.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .problems {
    margin-bottom: var(--space-7);
  }

  .answer {
    max-width: 44rem;
  }

  .answer .muted {
    margin: 0;
  }

  .goals {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 62rem) {
    .goals {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .goal {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-6);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
  }

  .goal-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .goal-name {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .goal h3 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .wording {
    margin: 0;
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .wording p {
    margin: 0;
  }

  .how {
    flex: 1;
    margin: 0;
  }

  .features {
    margin: 0;
    font-size: var(--text-sm);
  }

  .features-label {
    font-weight: 600;
    color: var(--color-text);
  }

  .more {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: var(--size-touch-target);
    font-weight: 600;
  }

  .honest {
    max-width: 44rem;
    margin-top: var(--space-6);
  }

  .honest h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .honest p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .sources {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sources li {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
  }

  .sources li:first-child {
    padding-top: 0;
    border-top: 0;
  }
</style>
