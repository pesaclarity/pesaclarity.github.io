---
import { darkScreen } from "../lib/screens";
import { withBase } from "../lib/paths";
import Base from "../layouts/Base.astro";
import ScreenGallery from "../components/ScreenGallery.astro";
import Screen from "../components/Screen.astro";
import { appRelease, downloads, homeScreens, screens } from "../data/site";
import { goals, notEndorsed } from "../data/impact";

// The four reasons to trust it, each with where to read more.
const pillars = [
  {
    title: "Stays on your phone",
    body: "Your records and every sum stay on your phone, and work without internet. Only you see your money.",
    link: "What stays on your phone",
    href: withBase("/security/#on-your-phone"),
  },
  {
    title: "Free, with no ads",
    body: "Every feature, for everyone. Paid for by small gifts, never by your data.",
    link: "How gifts help",
    href: withBase("/sponsor/"),
  },
  {
    title: "Open source, and checkable",
    body: "Anyone can read the code that handles their money, and rebuild the F-Droid build to compare it.",
    link: "Verify the app",
    href: withBase("/security/#verify"),
  },
  {
    title: "Plain answers",
    body: "Clear words, and one number first. Ask about your money in your own words.",
    link: "What it does",
    href: withBase("/features/"),
  },
];

const steps = [
  "Pick your accounts and how far back",
  "The app reads those SMS on your phone",
  "Get your plan",
];
const heroDark = darkScreen("home");
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1 id="hero-title">
          Know where your <span class="accent">pesa</span> goes.
        </h1>
        <p class="lead">
          Your M-Pesa and bank SMS, turned into a simple daily plan. Free,
          private, and on your phone.
        </p>
        <div class="button-row">
          <a
            class="button button-primary button-large"
            href={downloads.android}
          >
            Download for Android
          </a>
          <a class="button button-secondary button-large" href="#how">
            How it works
          </a>
        </div>
        <p class="hero-meta muted" data-version={appRelease?.version}>
          {appRelease ? `Version ${appRelease.version} · ` : ""}
          <a href={withBase("/install/")}>Other ways to install</a>, including
          F-Droid and iPhone
        </p>
      </div>

      <figure class="showcase">
        <div class="glow" aria-hidden="true"></div>
        {/* With a dark pair both are lazy, so only the shown one is fetched;
            the hero is in view, so lazy still starts it at once. */}
        <img
          class:list={["hero-screen", { "screen-light": heroDark }]}
          src={withBase("/screens/home.webp")}
          width="390"
          height="844"
          alt={screens.home.alt}
          fetchpriority="high"
          loading={heroDark ? "lazy" : undefined}
          decoding={heroDark ? "async" : undefined}
        />
        {heroDark && (
          <img
            class="hero-screen screen-dark"
            src={withBase(`/screens/${heroDark}.webp`)}
            width="390"
            height="844"
            alt={screens.home.alt}
            fetchpriority="high"
            loading="lazy"
            decoding="async"
          />
        )}
      </figure>
    </div>
  </section>

  <section class="section pillars-section" aria-labelledby="pillars-title">
    <div class="container">
      <h2 id="pillars-title" class="visually-hidden">
        Why trust it
      </h2>
      <ul class="cards cards-4 pillars" role="list">
        {pillars.map((p) => (
          <li class="card-item pillar">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            <a href={p.href}>{p.link}</a>
          </li>
        ))}
      </ul>
      <p class="pillars-more muted">
        Read further: <a href={withBase("/docs/rayo/")}>rayo</a>, the small
        runtime that runs Ask on the phone; the{" "}
        <a href={withBase("/docs/security/")}>security docs</a>; the{" "}
        <a href={withBase("/docs/ml/privacy-audit/")}>privacy audit</a> every
        model must pass before it leaves the server; and the{" "}
        <a href={withBase("/docs/ml/dp-sgd-review/")}>
          differential privacy review
        </a>{" "}
        of the training code.
      </p>
    </div>
  </section>

  <section id="why" class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="why">
        <div class="why-copy">
          <p class="eyebrow">Impact</p>
          <h2 id="why-title">Clear money, for everyone.</h2>
          <p>
            In Kenya, money moves through M-Pesa and bank SMS with no clear
            picture, and a small business needs proper books. Pesa Clarity turns
            those messages into a plan and simple books, on your phone and for
            free.
          </p>
          <a class="button button-secondary" href={withBase("/impact/")}>
            The problem and the goals
          </a>
        </div>
        <ul
          class="why-goals"
          role="list"
          aria-label="UN goals it aims to contribute to"
        >
          {goals.map((g) => (
            <li>
              <span class={`sdg sdg-${g.n}`} aria-hidden="true">
                {g.n}
              </span>
              <span>
                <strong>
                  Goal {g.n}: {g.goal}
                </strong>
                <span class="muted">Target {g.target}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
      <p class="why-note muted">
        Pesa Clarity aims to contribute to these UN Sustainable Development
        Goals. {notEndorsed}
      </p>
    </div>
  </section>

  <section id="screens" class="section" aria-labelledby="screens-title">
    <div class="container">
      <h2 id="screens-title" class="label">
        See where it goes
      </h2>
      <ScreenGallery screens={homeScreens} label="Screens" />
      <ol id="how" class="steps" role="list" aria-label="How it works">
        {steps.map((s, i) => (
          <li>
            <span class="step-n number" aria-hidden="true">
              {i + 1}
            </span>
            <span>{s}</span>
          </li>
        ))}
      </ol>
      <div class="button-row">
        <a class="button button-secondary" href={withBase("/features/")}>
          See everything it does
        </a>
        <a class="button button-secondary" href={withBase("/analyse/")}>
          Try the statement analyser
        </a>
      </div>
    </div>
  </section>

  <section id="business" class="section" aria-labelledby="business-title">
    <div class="container">
      <div class="business">
        <div class="business-copy">
          <p class="eyebrow">For business too</p>
          <h2 id="business-title">Your shop, on the same phone.</h2>
          <p>
            Sell from your phone, take cash, M-Pesa or credit, keep stock and
            close the day. A business space keeps its money apart from yours.
          </p>
          <a
            class="button button-secondary"
            href={withBase("/features/#business")}
          >
            Business features
          </a>
        </div>
        <div class="business-shot">
          <Screen screen={screens.sell} />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-7);
    background:
      radial-gradient(
        48rem 32rem at 80% 0%,
        var(--color-subtle),
        transparent 70%
      ),
      radial-gradient(
        36rem 24rem at 0% 100%,
        var(--color-subtle),
        transparent 70%
      ),
      var(--color-background);
  }

  .hero-inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  h1 {
    font-size: var(--text-hero);
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin-bottom: var(--space-5);
  }

  .accent {
    color: var(--color-brand-link);
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 34rem;
    margin-bottom: var(--space-6);
  }

  .hero-meta {
    margin: var(--space-5) 0 0;
    font-size: var(--text-sm);
  }

  .showcase {
    position: relative;
    margin: 0;
    display: grid;
    place-items: center;
  }

  .hero-screen {
    position: relative;
    width: min(100%, 20rem);
    height: auto;
    border-radius: 2.75rem;
    border: 8px solid var(--color-device);
    box-shadow: 0 50px 100px -40px var(--color-shadow);
  }

  .glow {
    position: absolute;
    width: min(30rem, 90%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-subtle), transparent 65%);
  }

  /* Trust pillars */
  .pillars-section {
    background: var(--color-surface);
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--color-background);
  }

  .pillar::before {
    content: "";
    width: 2.25rem;
    height: 4px;
    border-radius: 2px;
    background: var(--color-brand);
    margin-bottom: var(--space-4);
  }

  .pillar p {
    flex: 1;
    margin: 0;
  }

  .pillars-more {
    margin: var(--space-6) 0 0;
    max-width: 48rem;
    font-size: var(--text-sm);
  }

  .pillar a {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: var(--size-touch-target);
    font-weight: 600;
  }

  /* Steps under the screens */
  .steps {
    display: grid;
    gap: var(--space-4) var(--space-6);
    list-style: none;
    margin: var(--space-7) 0 var(--space-5);
    padding: 0;
  }

  @media (min-width: 52rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .steps li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.35;
  }

  .step-n {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-weight: 700;
    font-size: var(--text-base);
  }

  /* For business too */
  .business {
    display: grid;
    gap: var(--space-6);
    align-items: end;
    padding: clamp(1.5rem, 1rem + 3vw, 3rem) clamp(1.5rem, 1rem + 3vw, 3rem) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-surface);
    overflow: hidden;
  }

  @media (min-width: 52rem) {
    .business {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }

  .business-copy {
    align-self: center;
    padding-bottom: clamp(1.5rem, 1rem + 3vw, 3rem);
  }

  .business-copy h2 {
    font-size: var(--text-section);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .business-copy p:not(.eyebrow) {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 32rem;
    margin-bottom: var(--space-5);
  }

  /* The top of the Sell screen, rising from the bottom of the card. */
  .business-shot {
    display: flex;
    justify-content: center;
    height: clamp(16rem, 12rem + 10vw, 22rem);
    overflow: hidden;
  }

  .business-shot :global(img) {
    width: min(100%, 16rem);
    height: auto;
    border-radius: 2rem 2rem 0 0;
    border: 6px solid var(--color-device);
    border-bottom: 0;
    box-shadow: 0 30px 60px -30px var(--color-shadow);
  }
  /* Impact */
  .why {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .why {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }

  .why-copy h2 {
    font-size: var(--text-section);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .why-copy p:not(.eyebrow) {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 34rem;
    margin-bottom: var(--space-5);
  }

  .why-goals {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-surface);
  }

  .why-goals li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .why-goals li:first-child {
    border-top: 0;
  }

  .why-goals .muted {
    display: block;
  }

  .why-note {
    margin: var(--space-5) 0 0;
    max-width: 48rem;
    font-size: var(--text-sm);
  }
</style>
