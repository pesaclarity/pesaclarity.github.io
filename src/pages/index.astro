---
import { withBase } from "../lib/paths";
import Base from "../layouts/Base.astro";
import ScreenGallery from "../components/ScreenGallery.astro";
import {
  accounts,
  apkFiles,
  different,
  downloadSize,
  downloads,
  faqs,
  homeScreens,
  links,
  releaseTag,
  sides,
  spaces,
  whatsNew,
} from "../data/site";
import { fetchAppRelease, formatDay, formatSize } from "../data/release.mjs";

const release = await fetchAppRelease(releaseTag, {
  token: import.meta.env.GITHUB_TOKEN,
});
const releaseDay = release ? formatDay(release.date) : null;
const mainSize = formatSize(release?.sizes[apkFiles.android] ?? NaN);
const newest = release?.changes.slice(0, whatsNew.homeCount) ?? [];

const highlights = [
  "Free forever",
  "Private by design",
  "Works from your SMS",
  "Open source",
];

const does = [
  { title: "Spend today", body: "How much you can safely spend" },
  { title: "Bills", body: "What's due, in good time" },
  { title: "Leaks", body: "Where your money goes" },
  { title: "Debts", body: "Your debt-free date" },
  { title: "Savings", body: "Goals and a rainy day fund" },
  { title: "Business", body: "Sales, stock and who owes you" },
  { title: "Reports", body: "Receipts, invoices and reports" },
  { title: "Tax", body: "Estimates for your business" },
];

const features = [
  "Your money summary in a minute",
  "What changed this month",
  "Tap any figure to see why",
  "Early warning before you run low",
  "A payday plan",
  "A money health score",
  "A Fuliza tracker",
  "Who owes who",
];

const steps = [
  "Pick your accounts and how far back",
  "The app reads those SMS on your phone",
  "Get your plan",
];
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1 id="hero-title">
          Know where your <span class="accent">pesa</span> goes.
        </h1>
        <p class="lead">
          Your M-Pesa and bank SMS, turned into a simple daily plan for you,
          your home and your business. Free, private, and on your phone.
        </p>
        <div class="button-row">
          <a
            class="button button-primary button-large"
            href={downloads.android}
          >
            Download for Android
          </a>
          <a class="button button-secondary button-large" href="#how">
            How it works
          </a>
        </div>
      </div>

      <figure class="showcase">
        <div class="glow" aria-hidden="true"></div>
        <img
          class="hero-screen"
          src={withBase("/screens/home.webp")}
          width="390"
          height="844"
          alt="Pesa Clarity home screen showing safe to spend today, money left this month and upcoming bills"
          fetchpriority="high"
        />
      </figure>
    </div>

    <div class="container">
      <ul class="highlights" role="list">
        {highlights.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="sides" class="section section-alt" aria-labelledby="sides-title">
    <div class="container">
      <h2 id="sides-title" class="label">
        {sides.title}
      </h2>
      <ul class="sides" role="list">
        {sides.items.map((side) => (
          <li class="side">
            <div class="side-copy">
              <h3>{side.title}</h3>
              <p>{side.body}</p>
              <a
                class="button button-secondary"
                href={withBase(`/features/#${side.anchor}`)}
              >
                {side.link}
              </a>
            </div>
            <div class="side-shot">
              <img
                src={withBase(`/screens/${side.screen.file}.webp`)}
                width="390"
                height="844"
                alt={side.screen.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="what" class="section" aria-labelledby="what-title">
    <div class="container">
      <h2 id="what-title" class="label">
        What it does
      </h2>
      <ul class="cards cards-4" role="list">
        {does.map((d) => (
          <li class="card-item">
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section
    id="screens"
    class="section section-alt"
    aria-labelledby="screens-title"
  >
    <div class="container">
      <h2 id="screens-title" class="label">
        Screens
      </h2>
      <ScreenGallery screens={homeScreens} label="Screens" />
    </div>
  </section>

  <section id="features" class="section" aria-labelledby="features-title">
    <div class="container">
      <h2 id="features-title" class="label">
        Features
      </h2>
      <ul class="cards cards-3" role="list">
        {features.map((f) => (
          <li class="card-item">
            <h3>{f}</h3>
          </li>
        ))}
      </ul>
      <div class="button-row after-cards">
        <a class="button button-secondary" href={withBase("/features/")}>
          See everything it does
        </a>
      </div>
    </div>
  </section>

  <section
    id="spaces"
    class="section section-alt"
    aria-labelledby="spaces-title"
  >
    <div class="container">
      <h2 id="spaces-title" class="label">
        A space for each part of life
      </h2>
      <ul class="cards cards-4" role="list">
        {spaces.map((s) => (
          <li class="card-item">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="how" class="section section-alt" aria-labelledby="how-title">
    <div class="container">
      <h2 id="how-title" class="label">
        How it works
      </h2>
      <ol class="cards cards-3 steps" role="list">
        {steps.map((s, i) => (
          <li class="card-item">
            <span class="step-n number">{i + 1}</span>
            <h3>{s}</h3>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="works-with" class="section" aria-labelledby="works-title">
    <div class="container">
      <h2 id="works-title" class="label">
        Works with
      </h2>
      <ul class="cards cards-3" role="list">
        {accounts.map((a) => (
          <li class="card-item">
            <h3>{a.name}</h3>
            {a.note && <p>{a.note}</p>}
          </li>
        ))}
      </ul>
      <div class="button-row after-cards">
        <a class="button button-secondary" href={links.parsers}>
          Add your bank
        </a>
      </div>
    </div>
  </section>

  <section id="why" class="section section-alt" aria-labelledby="why-title">
    <div class="container">
      <h2 id="why-title" class="label">
        Why Pesa Clarity
      </h2>
      <ul class="cards cards-4" role="list">
        {different.map((d) => (
          <li class="card-item">
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="privacy" class="section" aria-labelledby="privacy-title">
    <div class="container split">
      <h2 id="privacy-title" class="label">
        Privacy
      </h2>
      <div>
        <p class="statement">
          Your data stays on your phone. Our server keeps only your sign-in and
          encrypted backups.
        </p>
        <a class="button button-secondary" href={withBase("/privacy/")}>
          Privacy policy
        </a>
      </div>
    </div>
  </section>

  <section
    id="open-source"
    class="section section-alt"
    aria-labelledby="foss-title"
  >
    <div class="container split">
      <h2 id="foss-title" class="label">
        Open source
      </h2>
      <div>
        <p class="statement">
          The code is public. Star it, add your bank, or help build it.
        </p>
        <div class="button-row">
          <a class="button button-primary" href={links.star}>
            Star on GitHub
          </a>
          <a class="button button-secondary" href={links.parserContributing}>
            Add your bank
          </a>
          <a class="button button-secondary" href={links.contribute}>
            How to contribute
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="section" aria-labelledby="faq-title">
    <div class="container split">
      <h2 id="faq-title" class="label">
        FAQ
      </h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="download" class="section" aria-labelledby="download-title">
    <div class="container">
      <div class="cta">
        <h2 id="download-title">Get the app.</h2>
        <div class="button-row">
          <a
            class="button button-primary button-large"
            href={downloads.android}
          >
            Android
          </a>
          <a
            class="button button-secondary button-large"
            href={downloads.fdroid}
          >
            F-Droid build
          </a>
        </div>
        <p class="muted" data-version={release?.version}>
          {release
            ? `Version ${release.version}${releaseDay ? `, ${releaseDay}` : ""}. `
            : ""}
          {downloads.testBuild ? "Test build, updated often. " : ""}
          {mainSize ? `${mainSize} for most phones` : downloadSize}. Open the
          file on your phone and allow installs when asked. Older phone? Get the{" "}
          <a href={downloads.android32}>version for older phones</a>.{" "}
          <a href={withBase("/install/")}>How to install</a> ·{" "}
          <a href={links.releases}>All releases</a>
        </p>
        {release && newest.length > 0 && (
          <div class="cta-new">
            <h3>{whatsNew.title(release.version)}</h3>
            <ul>
              {newest.map((change) => (
                <li>{change}</li>
              ))}
            </ul>
            <a href={withBase("/install/#whats-new")}>{whatsNew.more}</a>
          </div>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-7) var(--space-6);
    background:
      radial-gradient(
        48rem 32rem at 80% 0%,
        var(--color-brand-soft),
        transparent 70%
      ),
      radial-gradient(
        36rem 24rem at 0% 100%,
        var(--color-brand-soft),
        transparent 70%
      ),
      var(--color-background);
  }

  .hero-inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  h1 {
    font-size: var(--text-hero);
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin-bottom: var(--space-5);
  }

  .accent {
    color: var(--color-brand-link);
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 34rem;
    margin-bottom: var(--space-6);
  }

  .showcase {
    position: relative;
    margin: 0;
    display: grid;
    place-items: center;
  }

  .hero-screen {
    position: relative;
    width: min(100%, 22rem);
    height: auto;
    border-radius: 2.75rem;
    border: 8px solid var(--color-device);
    box-shadow: 0 50px 100px -40px rgb(58 47 51 / 0.45);
  }

  .glow {
    position: absolute;
    width: min(30rem, 90%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-brand) 22%, transparent),
      transparent 65%
    );
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: var(--space-5) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  @media (min-width: 52rem) {
    .highlights {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .highlights li + li {
      border-left: 1px solid var(--color-border);
      padding-left: var(--space-5);
    }
  }

  /* Personal and business, side by side */
  .sides {
    display: grid;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 52rem) {
    .sides {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .side {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
  }

  .side-copy {
    padding: var(--space-6) var(--space-6) var(--space-5);
  }

  .side-copy h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .side-copy p {
    color: var(--color-text-muted);
    max-width: 30rem;
    margin-bottom: var(--space-5);
  }

  /* The top of the screen, rising from the bottom of the card. */
  .side-shot {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    height: clamp(14rem, 10rem + 12vw, 20rem);
    overflow: hidden;
    padding-inline: var(--space-5);
  }

  .side-shot img {
    width: min(100%, 17rem);
    height: auto;
    border-radius: 2rem 2rem 0 0;
    border: 6px solid var(--color-device);
    border-bottom: 0;
    box-shadow: 0 30px 60px -30px rgb(58 47 51 / 0.4);
  }

  .step-n {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-weight: 700;
    margin-bottom: var(--space-4);
  }

  /* What's new, under the download buttons */
  .cta-new {
    flex-basis: 100%;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .cta-new h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .cta-new ul {
    margin: 0 0 var(--space-3);
    padding-left: 1.2em;
    color: var(--color-text-muted);
  }

  .cta-new li + li {
    margin-top: var(--space-1);
  }

  /* FAQ */
  .faq-list {
    display: grid;
    gap: var(--space-3);
  }

  .faq {
    border-radius: var(--radius-card);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: "+";
    flex: none;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1;
    color: var(--color-brand-link);
  }

  .faq[open] summary::after {
    content: "−";
  }

  .faq p {
    margin: 0;
    padding: 0 var(--space-5) var(--space-5);
    color: var(--color-text-muted);
  }
</style>
