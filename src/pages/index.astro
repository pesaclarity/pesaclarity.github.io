---
import { withBase } from "../lib/paths";
import Base from "../layouts/Base.astro";
import PlayButton from "../components/PlayButton.astro";
import Screen from "../components/Screen.astro";
import {
  appRelease,
  links,
  playRelease,
  screens,
  testRelease,
} from "../data/site";
import { goals, notEndorsed } from "../data/impact";

// What the app shows, each with its own screen. On phones they scroll
// sideways in one row; wider screens show all four side by side.
const features = [
  {
    title: "Daily plan",
    body: "Know what is safe to spend today. One number, from your balances, bills and plan.",
    screen: screens.plan,
  },
  {
    title: "Activity",
    body: "Every payment, read from your messages. Fees and Fuliza charges counted, not hidden.",
    screen: screens.activity,
  },
  {
    title: "Bills and debts",
    body: "See what is due and what you owe: loans, Fuliza and money lent to friends.",
    screen: screens.debts,
  },
  {
    title: "Insights",
    body: "Where your money went this month, and where it leaks. Ask in your own words.",
    screen: screens.insights,
  },
];

// The app's own setup, in its order (pesaclarity-app, onboarding routes).
const steps = [
  {
    title: "Choose your currency and how money comes to you",
    body: "Salary, business, family support. Pick all that fit.",
  },
  {
    title: "Tick your accounts",
    body: "M-Pesa, Airtel Money, Equity, KCB and more. Only their messages are read.",
  },
  {
    title: "Let the app read those SMS",
    body: "On your phone. It keeps the amount, date, fee and payee, then deletes the text.",
  },
  {
    title: "Get your first look, then your plan",
    body: "Three optional questions shape your Plan and first goal.",
  },
];

// Each claim with the page that backs it.
const privacy = [
  {
    body: "Your transactions, messages and questions stay on your phone, in an encrypted database.",
    link: "Privacy policy",
    href: withBase("/privacy/"),
  },
  {
    body: "No account needed. Backups to our vault are encrypted on your phone first.",
    link: "Security",
    href: withBase("/security/"),
  },
  {
    body: "No ads, no trackers, no analytics.",
    link: "Privacy policy",
    href: withBase("/privacy/"),
  },
  {
    body: "Open source under AGPL-3.0. Read the code that handles your money.",
    link: "Source code",
    href: links.appSource,
  },
];
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1 id="hero-title">Your money has a plan now.</h1>
        <p class="lead">
          Pesa Clarity reads your M-Pesa and bank SMS on your phone and shows
          what you can safely spend today. Free, no ads, open source.
        </p>
        <div class="button-row">
          <PlayButton />
          <a class="button button-secondary button-large" href="#how">
            How it works
          </a>
        </div>
        <p class="hero-meta muted" data-version={appRelease?.version}>
          {playRelease
            ? `Google Play ${playRelease.version.replace(/^v/, "")} · `
            : ""}
          {testRelease ? `Test build ${testRelease.version} · ` : ""}
          iPhone test build and F-Droid:{" "}
          <a href={withBase("/install/")}>other ways to install</a>
        </p>
      </div>
      <div class="shot hero-shot">
        <Screen screen={screens.home} priority />
      </div>
    </div>
  </section>

  <section class="section rule" aria-labelledby="features-title">
    <div class="container">
      <h2 id="features-title" class="title">
        What it shows you
      </h2>
      <ul
        class="features"
        role="list"
        aria-label="What it shows you, one screen each"
        tabindex="0"
      >
        {features.map((f, i) => (
          <li>
            <div class="shot">
              <Screen screen={f.screen} eager={i === 0} />
            </div>
            <h3>{f.title}</h3>
            <p class="muted">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="how" class="section rule" aria-labelledby="how-title">
    <div class="container">
      <h2 id="how-title" class="title">
        How it works
      </h2>
      <ol class="grid-4 steps" role="list">
        {steps.map((s, i) => (
          <li>
            <span class="step-n number" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{s.title}</h3>
            <p class="muted">{s.body}</p>
          </li>
        ))}
      </ol>
      <p class="note">
        No bank login. Pesa Clarity does not connect to your bank; it reads the
        SMS your bank already sends you. On iPhone, a Shortcuts automation
        passes messages in.
      </p>
    </div>
  </section>

  <section class="section rule" aria-labelledby="privacy-title">
    <div class="container">
      <h2 id="privacy-title" class="title">
        Your money stays on your phone.
      </h2>
      <ul class="grid-4 claims" role="list">
        {privacy.map((p) => (
          <li>
            <p>{p.body}</p>
            <a href={p.href}>{p.link}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="business" class="section rule" aria-labelledby="business-title">
    <div class="container two">
      <div>
        <h2 id="business-title" class="title">
          For you, and for your shop.
        </h2>
        <p class="lead">
          Keep your own money in Personal. Add a business space to sell, take
          cash, M-Pesa or credit, track stock and close the day. Each space
          keeps its money apart.
        </p>
        <a
          class="button button-secondary"
          href={withBase("/features/#business")}
        >
          Business features
        </a>
      </div>
      <div class="shot business-shot">
        <Screen screen={screens.sell} />
      </div>
    </div>
  </section>

  <section id="why" class="section rule" aria-labelledby="why-title">
    <div class="container">
      <div class="why-head">
        <div>
          <h2 id="why-title" class="title">
            Clear money, for everyone.
          </h2>
          <p class="lead">
            Pesa Clarity aims to contribute to three of the UN Sustainable
            Development Goals.
          </p>
        </div>
        <a class="button button-secondary" href={withBase("/impact/")}>
          The problem and the goals
        </a>
      </div>
      <ul class="goals" role="list">
        {goals.map((g) => (
          <li class="goal">
            <span class={`sdg sdg-${g.n} goal-n`} aria-hidden="true">
              {g.n}
            </span>
            <p class="goal-label">
              Goal {g.n} <span aria-hidden="true">·</span> Target {g.target}
            </p>
            <h3>{g.goal}</h3>
            <p class="goal-short">{g.short}</p>
          </li>
        ))}
      </ul>
      <p class="note muted">These are aims, not results. {notEndorsed}</p>
    </div>
  </section>

  <section class="section rule" aria-labelledby="open-title">
    <div class="container">
      <h2 id="open-title" class="title">
        Open, so you can check it.
      </h2>
      <p class="lead">
        The app, the message rules and this site are on GitHub. Report a message
        it reads wrongly, or add your bank.
      </p>
      <div class="button-row">
        <a class="button button-secondary" href={links.appSource}>
          App source
        </a>
        <a class="button button-secondary" href={links.parsers}>
          Message rules
        </a>
      </div>
    </div>
  </section>

  <section class="section rule" aria-labelledby="final-title">
    <div class="container final">
      <h2 id="final-title" class="title">
        Start with today's number.
      </h2>
      <PlayButton />
      <p class="muted">Free. No ads. No bank login.</p>
    </div>
  </section>
</Base>

<style>
  /* Plain backgrounds and thin rules; red only on the main button. */
  .hero {
    padding-block: var(--space-7);
  }

  .hero-inner,
  .two {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .hero-inner,
    .two {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  h1 {
    font-size: var(--text-hero);
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin-bottom: var(--space-5);
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 34rem;
    margin-bottom: var(--space-6);
  }

  .hero-meta {
    margin: var(--space-5) 0 0;
    font-size: var(--text-sm);
  }

  /* Links in text, not red: red is kept for the main button. */
  .hero-meta a,
  .claims a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .rule {
    border-top: 1px solid var(--color-border);
  }

  .title {
    font-size: var(--text-section);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: var(--space-6);
  }

  /* An app screen in a plain device frame. */
  .shot {
    display: flex;
    justify-content: center;
  }

  .shot :global(img) {
    width: min(100%, 16rem);
    height: auto;
    border-radius: 2rem;
    border: 6px solid var(--color-device);
  }

  .hero-shot :global(img) {
    width: min(100%, 14rem);
    border-radius: 2.25rem;
    border-width: 8px;
  }

  @media (min-width: 62rem) {
    .hero-shot :global(img) {
      width: min(100%, 19rem);
      border-radius: 2.75rem;
    }
  }

  /* Phones: one row that scrolls sideways and snaps to each screen. */
  .features {
    list-style: none;
    /* Runs to the screen's edges, so the next screen peeks in. */
    margin: 0 calc(-1 * var(--gutter));
    padding: 0 var(--gutter) var(--space-4);
    scroll-padding-inline: var(--gutter);
    display: flex;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  .features li {
    flex: 0 0 min(75%, 16rem);
    scroll-snap-align: start;
  }

  .features:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }

  .features .shot {
    justify-content: flex-start;
  }

  .features h3 {
    margin: var(--space-4) 0 var(--space-2);
  }

  /* Number on the left, words beside it. */
  .steps li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: start;
    align-content: start;
  }

  .steps .step-n {
    grid-row: span 2;
  }

  .steps h3 {
    margin: 0.35rem 0 var(--space-2);
  }

  .features p,
  .steps p {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .features {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
      margin: 0;
      padding: 0;
    }

    .features .shot {
      justify-content: center;
    }
  }

  .grid-4 {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5) var(--space-6);
  }

  @media (min-width: 40rem) {
    .grid-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .grid-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .step-n {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    font-weight: 700;
  }

  .note {
    margin: var(--space-6) 0 0;
    max-width: 44rem;
  }

  .claims li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }

  .claims p {
    margin: 0;
    flex: 1;
  }

  .claims a {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: var(--size-touch-target);
    font-weight: 600;
  }

  /* The top of the Sell screen, cut by a thin rule. */
  .business-shot {
    height: clamp(18rem, 14rem + 10vw, 26rem);
    overflow: hidden;
    align-items: flex-start;
    border-bottom: 1px solid var(--color-border);
  }

  .business-shot :global(img) {
    border-bottom: 0;
    border-radius: 2rem 2rem 0 0;
  }

  /* UN goals: each goal's number on its own colour, as the UN shows it;
     everything else stays plain. */
  .why-head {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .why-head .title {
    margin-bottom: var(--space-4);
  }

  .why-head .lead {
    margin: 0;
  }

  .why-head .button {
    justify-self: start;
  }

  @media (min-width: 62rem) {
    .why-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }

  .goals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 62rem) {
    .goals {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .goal {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-4);
    align-content: start;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .goal-n {
    grid-row: span 2;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    font-size: 1.75rem;
    letter-spacing: -0.04em;
  }

  .goal-label {
    margin: 0;
    align-self: end;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .goal h3 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .goal-short {
    grid-column: 1 / -1;
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
  }

  @media (min-width: 62rem) {
    .goal {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-6);
    }

    .goal-n {
      grid-row: auto;
      width: 4.5rem;
      height: 4.5rem;
      border-radius: 1.25rem;
      font-size: 2.25rem;
      margin-bottom: var(--space-6);
    }

    .goal h3 {
      margin-top: var(--space-2);
      font-size: 1.5rem;
    }
  }

  .final {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .final .title,
  .final p {
    margin: 0;
  }
</style>
