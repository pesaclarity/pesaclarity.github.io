---
// Mockup of the proposed homepage, for approval only. Not linked, noindex.
import { withBase } from "../../lib/paths";
import Base from "../../layouts/Base.astro";
import PlayButton from "../../components/PlayButton.astro";
import Screen from "../../components/Screen.astro";
import { links, screens } from "../../data/site";

const features = [
  {
    title: "Daily plan",
    body: "Know what is safe to spend today. One number, from your balances, bills and plan.",
    screen: screens.home,
  },
  {
    title: "Activity",
    body: "Every payment, read from your messages. Fees and Fuliza charges counted, not hidden.",
    screen: screens.activity,
  },
  {
    title: "Bills and debts",
    body: "See what is due and what you owe: loans, Fuliza and money lent to friends.",
    screen: screens.debts,
  },
  {
    title: "Insights",
    body: "Where your money went this month, and where it leaks. Ask in your own words.",
    screen: screens.insights,
  },
];

const steps = [
  {
    title: "Choose your currency and how money comes to you",
    body: "Salary, business, family support. Pick all that fit.",
  },
  {
    title: "Tick your accounts",
    body: "M-Pesa, Airtel Money, Equity, KCB and more. Only their messages are read.",
  },
  {
    title: "Let the app read those SMS",
    body: "On your phone. It keeps the amount, date, fee and payee, then deletes the text.",
  },
  {
    title: "Get your first look, then your plan",
    body: "Three optional questions shape your Plan and first goal.",
  },
];

const privacy = [
  {
    body: "Your transactions, messages and questions stay on your phone, in an encrypted database.",
    link: "Privacy policy",
    href: withBase("/privacy/"),
  },
  {
    body: "No account needed. Backups to our vault are encrypted on your phone first.",
    link: "Security",
    href: withBase("/security/"),
  },
  {
    body: "No ads, no trackers, no analytics.",
    link: "Privacy policy",
    href: withBase("/privacy/"),
  },
  {
    body: "Open source under AGPL-3.0. Read the code that handles your money.",
    link: "Source code",
    href: links.appSource,
  },
];
---

<Base title="Homepage mockup" noindex>
  <section class="m-hero" aria-labelledby="m-hero-title">
    <div class="container m-hero-inner">
      <div>
        <h1 id="m-hero-title">Your money has a plan now.</h1>
        <p class="m-lead">
          Pesa Clarity reads your M-Pesa and bank SMS on your phone and shows
          what you can safely spend today. Free, no ads, open source.
        </p>
        <div class="button-row">
          <PlayButton />
          <a class="button button-secondary button-large" href="#how">
            How it works
          </a>
        </div>
        <p class="muted m-small">
          iPhone test build and F-Droid:{" "}
          <a href={withBase("/install/")}>other ways to install</a>
        </p>
      </div>
      <div class="m-shot m-shot-hero">
        <Screen screen={screens.home} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="m-features">
    <div class="container">
      <h2 id="m-features" class="m-h2">
        What it shows you
      </h2>
      <ul class="m-features" role="list">
        {features.map((f) => (
          <li>
            <div class="m-shot">
              <Screen screen={f.screen} />
            </div>
            <h3>{f.title}</h3>
            <p class="muted">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="how" class="section m-line" aria-labelledby="m-how">
    <div class="container">
      <h2 id="m-how" class="m-h2">
        How it works
      </h2>
      <ol class="m-steps" role="list">
        {steps.map((s, i) => (
          <li>
            <span class="m-n number">{i + 1}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.body}</p>
          </li>
        ))}
      </ol>
      <p class="m-note">
        No bank login. Pesa Clarity does not connect to your bank; it reads the
        SMS your bank already sends you. On iPhone, a Shortcuts automation
        passes messages in.
      </p>
    </div>
  </section>

  <section class="section m-line" aria-labelledby="m-privacy">
    <div class="container">
      <h2 id="m-privacy" class="m-h2">
        Your money stays on your phone.
      </h2>
      <ul class="m-list" role="list">
        {privacy.map((p) => (
          <li>
            <p>{p.body}</p>
            <a href={p.href}>{p.link}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section m-line" aria-labelledby="m-biz">
    <div class="container m-two">
      <div>
        <h2 id="m-biz" class="m-h2">
          For you, and for your shop.
        </h2>
        <p class="m-lead">
          Keep your own money in Personal. Add a business space to sell, take
          cash, M-Pesa or credit, track stock and close the day. Each space
          keeps its money apart.
        </p>
        <a
          class="button button-secondary"
          href={withBase("/features/#business")}
        >
          Business features
        </a>
      </div>
      <div class="m-shot">
        <Screen screen={screens.sell} />
      </div>
    </div>
  </section>

  <section class="section m-line" aria-labelledby="m-open">
    <div class="container">
      <h2 id="m-open" class="m-h2">
        Open, so you can check it.
      </h2>
      <p class="m-lead">
        The app, the message rules and this site are on GitHub. Report a message
        it reads wrongly, or add your bank.
      </p>
      <div class="button-row">
        <a class="button button-secondary" href={links.appSource}>
          App source
        </a>
        <a class="button button-secondary" href={links.parsers}>
          Message rules
        </a>
      </div>
    </div>
  </section>

  <section class="section m-line" aria-labelledby="m-final">
    <div class="container m-final">
      <h2 id="m-final" class="m-h2">
        Start with today's number.
      </h2>
      <PlayButton />
      <p class="muted">Free. No ads. No bank login.</p>
    </div>
  </section>
</Base>

<style>
  .m-hero {
    padding-block: var(--space-7);
    background: var(--color-background);
  }
  .m-hero-inner,
  .m-two {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 62rem) {
    .m-hero-inner,
    .m-two {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    }
  }
  h1 {
    font-size: var(--text-hero);
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin-bottom: var(--space-5);
  }
  .m-lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 34rem;
    margin-bottom: var(--space-6);
  }
  .m-small {
    font-size: var(--text-sm);
    margin-top: var(--space-5);
  }
  .m-h2 {
    font-size: var(--text-section);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: var(--space-6);
  }
  .m-line {
    border-top: 1px solid var(--color-border);
  }
  .m-shot {
    display: flex;
    justify-content: center;
  }
  .m-shot :global(img) {
    width: min(100%, 16rem);
    height: auto;
    border-radius: 2rem;
    border: 6px solid var(--color-device);
  }
  .m-shot-hero :global(img) {
    width: min(100%, 19rem);
  }
  .m-features,
  .m-steps,
  .m-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-7) var(--space-6);
  }
  @media (min-width: 48rem) {
    .m-features,
    .m-steps,
    .m-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 72rem) {
    .m-features,
    .m-steps,
    .m-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .m-features h3,
  .m-steps h3 {
    margin: var(--space-4) 0 var(--space-2);
  }
  .m-n {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    font-weight: 700;
  }
  .m-note {
    margin-top: var(--space-6);
    max-width: 44rem;
  }
  .m-list li {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }
  .m-list a {
    font-weight: 600;
  }
  .m-final {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }
</style>
