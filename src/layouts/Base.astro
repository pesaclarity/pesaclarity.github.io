---
import { createHash } from "node:crypto";
import { withBase } from "../lib/paths";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-grotesk/latin-600.css";
import "@fontsource/space-grotesk/latin-700.css";
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { themeColours, themeScript } from "../lib/theme";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** A strict Content-Security-Policy as a meta tag (GitHub Pages sends no headers). */
  strictCsp?: boolean;
}

const {
  title,
  description = site.description,
  noindex = false,
  strictCsp = false,
} = Astro.props;
const themeHash = createHash("sha256").update(themeScript).digest("base64");
const csp = `default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-${themeHash}'; worker-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'`;
const pageTitle = title
  ? `${title} · ${site.name}`
  : `${site.name}: ${site.promise}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase("/og.png"), Astro.site);
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {strictCsp && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={themeColours.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColours.dark}
      media="(prefers-color-scheme: dark)"
    />
    <script is:inline set:html={themeScript} />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="The Pesa Clarity logo with the line: your money, made clear, without giving your data away."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
